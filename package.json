{
  "name": "@jekrch/react-viewport-lightbox",
  "version": "1.0.2",
  "description": "A headless-capable, touch-friendly React image viewer and lightbox with zoom, pan, and swipe.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lazy": {
      "import": {
        "types": "./dist/lazy.d.ts",
        "default": "./dist/lazy.js"
      },
      "require": {
        "types": "./dist/lazy.d.cts",
        "default": "./dist/lazy.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "lazy": [
        "./dist/lazy.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "size": "node scripts/check-size.mjs",
    "bench": "node scripts/bench.mjs",
    "check:package": "publint --pack npm && attw --pack . --exclude-entrypoints styles.css",
    "check:consumers": "scripts/check-consumers.sh",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playground": "vite playground",
    "playground:build": "vite build playground",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "playwright-core": "1.61.1",
    "prettier": "^3.3.0",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jekrch/react-viewport-lightbox.git"
  },
  "homepage": "https://github.com/jekrch/react-viewport-lightbox#readme",
  "bugs": {
    "url": "https://github.com/jekrch/react-viewport-lightbox/issues"
  },
  "author": "jekrch",
  "license": "MIT",
  "keywords": [
    "react",
    "lightbox",
    "react-viewport-lightbox",
    "gallery",
    "image-viewer",
    "zoom",
    "pan",
    "swipe",
    "headless"
  ],
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
